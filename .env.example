# Bedrock model: an inference profile ID or ARN. Never commit the real value.
JOB_SCOUT_MODEL=
AWS_REGION=eu-west-1
# AWS_PROFILE=your-profile
# Where application folders are written (default: data/private/applications)
# JOB_SCOUT_OUTPUT_DIR=
# Optional per-role overrides (same format as JOB_SCOUT_MODEL); unset roles use JOB_SCOUT_MODEL.
# JOB_SCOUT_MODEL_SCREEN=   # e.g. Haiku: a short classification
# JOB_SCOUT_MODEL_RESEARCH= # e.g. Sonnet
# JOB_SCOUT_MODEL_VET=      # e.g. Sonnet
# JOB_SCOUT_MODEL_TAILOR=   # e.g. Opus: the CV and application text
